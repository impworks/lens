<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net47;net10.0</TargetFrameworks>
        <LangVersion>latest</LangVersion>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' == 'net47'">
        <DefineConstants>NET_CLASSIC</DefineConstants>
    </PropertyGroup>

    <PropertyGroup Condition="'$(TargetFramework)' != 'net47'">
        <DefineConstants>NET_CORE</DefineConstants>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.12.0" />
        <PackageReference Include="NUnit" Version="3.14.0" />
        <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    </ItemGroup>

    <ItemGroup Condition="'$(TargetFramework)' == 'net47'">
        <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />

        <!-- the sequence points are read back with a portable-PDB reader, and .NET Framework writes
             Windows PDBs and has no such reader in the box. What the table has to say is the same
             on both platforms, so it is checked on the one that can read it. -->
        <Compile Remove="Features\DebugSequencePointsTest.cs" />

        <!-- System.Index and System.Range arrived with .NET Core 3.0 and are not in the .NET
             Framework box. The syntax that names them is resolved by name and works wherever the
             types do, which on this leg is only where the host has brought them along - so there
             is nothing here for the suite to run against. -->
        <Compile Remove="Features\IndexAndRangeTest.cs" />
    </ItemGroup>

    <!-- the end-to-end check that a LENS query really does reach a database is worth a dependency,
         but EF Core has no .NET Framework leg, so the test that uses it is compiled out there -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="8.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Lens\Lens.csproj" />
        <ProjectReference Include="..\Lens.LanguageServer.Core\Lens.LanguageServer.Core.csproj" />
    </ItemGroup>

</Project>
